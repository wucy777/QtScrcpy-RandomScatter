+// 校验 randomPos 字段结构是否可用；不合法就当没写，退回固定坐标
+KeyMap::RandomPos KeyMap::getItemRandomPos(const QJsonObject &node, const QString &name)
+{
+    RandomPos result;
+
+    if (!node.contains(name) || !node.value(name).isObject()) {
+        // 字段缺失：原版 keymap，静默退回固定坐标
+        return result;
+    }
+
+    QJsonObject obj = node.value(name).toObject();
+    if (!checkItemString(obj, "type") || !checkItemPos(obj, "p1") || !checkItemPos(obj, "p2")) {
+        qWarning() << "json warning: randomPos format error, fallback to fixed pos";
+        return result;
+    }
+
+    const QString shape = obj.value("type").toString();
+    if (0 == shape.compare(QStringLiteral("circle"), Qt::CaseInsensitive)) {
+        result.shape = RandomPos::RS_CIRCLE;
+    } else if (0 == shape.compare(QStringLiteral("rect"), Qt::CaseInsensitive)) {
+        result.shape = RandomPos::RS_RECT;
+    } else {
+        qWarning() << "json warning: unknown randomPos type, fallback to fixed pos:" << shape;
+        return result;
+    }
+
+    result.p1 = getItemPos(obj, "p1");
+    result.p2 = getItemPos(obj, "p2");
+
+    // ---- 可选：概率分布。缺失时保持 RD_UNIFORM，早期导出的 JSON 行为不变。
+    // 但确实建议用 gauss —— 均匀随机的统计特征太显眼，见 keymap.h 里的说明。
+    if (checkItemString(obj, "dist")) {
+        const QString dist = obj.value("dist").toString();
+        if (0 == dist.compare(QStringLiteral("gauss"), Qt::CaseInsensitive)
+            || 0 == dist.compare(QStringLiteral("normal"), Qt::CaseInsensitive)
+            || 0 == dist.compare(QStringLiteral("gaussian"), Qt::CaseInsensitive)) {
+            result.dist = RandomPos::RD_GAUSS;
+        } else if (0 == dist.compare(QStringLiteral("uniform"), Qt::CaseInsensitive)) {
+            result.dist = RandomPos::RD_UNIFORM;
+        } else {
+            qWarning() << "json warning: unknown randomPos dist, use uniform:" << dist;
+        }
+    }
+
+    if (checkItemDouble(obj, "sigma")) {
+        const double sigma = getItemDouble(obj, "sigma");
+        // 夹到合理区间：太小会退化成固定点，太大就接近均匀了
+        if (sigma >= 0.05 && sigma <= 2.0) {
+            result.sigma = sigma;
+        } else {
+            qWarning() << "json warning: randomPos sigma out of range, use default:" << sigma;
+        }
+    }
+
+    if (checkItemDouble(obj, "outlier")) {
+        const double outlier = getItemDouble(obj, "outlier");
+        if (outlier >= 0.0 && outlier <= 1.0) {
+            result.outlier = outlier;
+        } else {
+            qWarning() << "json warning: randomPos outlier out of range, ignore:" << outlier;
+        }
+    }
+
+    return result;
+}
