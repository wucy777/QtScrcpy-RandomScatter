+// 随机散布（改版新增）
+//
+// 坐标说明：keymap 里的 x / y 是相对坐标，x 按画面宽度、y 按画面高度分别归一化。
+// 因此「圆」必须换算到像素空间才是真正的圆，否则会退化成椭圆。
+// 这里统一做法是：两个控制点 -> 像素空间 -> 采样 -> 再换算回相对坐标。
+//
+// 分布说明：默认（RD_UNIFORM）是区域内均匀随机。但**均匀本身就是一种指纹** ——
+// 把落点按等面积同心环或等分格统计计数，各项近似相等，一眼就能看出是程序生成的。
+// 真人按按钮时手指往按钮中间落，中心密、边缘稀，呈钟形。所以 RD_GAUSS 用二维高斯，
+// 并可用 outlier 留一点小概率的大幅偏移做重尾。
+QPointF InputConvertGame::scatterPos(const QPointF &pos, const KeyMap::RandomPos &randomPos)
+{
+    if (!randomPos.isValid() || m_frameSize.width() <= 0 || m_frameSize.height() <= 0) {
+        return pos;
+    }
+
+    QRandomGenerator *rng = QRandomGenerator::global();
+    const double frameW = static_cast<double>(m_frameSize.width());
+    const double frameH = static_cast<double>(m_frameSize.height());
+
+    // 偶发「点偏了」：以 outlier 的概率直接改用区域内均匀采样，制造重尾。
+    // 真人不会每次都精准命中，留一点小概率的大幅偏移比纯高斯更像人。
+    bool forceUniform = false;
+    if (randomPos.outlier > 0.0 && rng->generateDouble() < randomPos.outlier) {
+        forceUniform = true;
+    }
+    const bool useGauss = (KeyMap::RandomPos::RD_GAUSS == randomPos.dist) && !forceUniform;
+
+    if (KeyMap::RandomPos::RS_RECT == randomPos.shape) {
+        // 两个对角点确定矩形；相对坐标下按轴独立采样
+        double x1 = qMin(randomPos.p1.x(), randomPos.p2.x());
+        double x2 = qMax(randomPos.p1.x(), randomPos.p2.x());
+        double y1 = qMin(randomPos.p1.y(), randomPos.p2.y());
+        double y2 = qMax(randomPos.p1.y(), randomPos.p2.y());
+
+        // 限制在屏幕内，避免点到黑边 / 屏幕外
+        x1 = qBound(0.0, x1, 1.0);
+        x2 = qBound(0.0, x2, 1.0);
+        y1 = qBound(0.0, y1, 1.0);
+        y2 = qBound(0.0, y2, 1.0);
+
+        if (!useGauss) {
+            const double rx = rng->generateDouble();
+            const double ry = rng->generateDouble();
+            return QPointF(x1 + (x2 - x1) * rx, y1 + (y2 - y1) * ry);
+        }
+
+        // 高斯：以矩形中心为峰，两轴独立。sigma 相对半宽给出，因此与像素尺寸无关。
+        const double cx = (x1 + x2) * 0.5;
+        const double cy = (y1 + y2) * 0.5;
+        const double sx = qMax((x2 - x1) * 0.5 * randomPos.sigma, 1e-9);
+        const double sy = qMax((y2 - y1) * 0.5 * randomPos.sigma, 1e-9);
+
+        double gx = cx;
+        double gy = cy;
+        for (int i = 0; i < 24; ++i) {
+            gx = cx + sx * nextGauss(rng);
+            gy = cy + sy * nextGauss(rng);
+            if (gx >= x1 && gx <= x2 && gy >= y1 && gy <= y2) {
+                return QPointF(gx, gy);
+            }
+        }
+        // 兜底：夹回矩形内（sigma 很大时才会走到这里，此时分布本来就接近均匀）
+        return QPointF(qBound(x1, gx, x2), qBound(y1, gy, y2));
+    }
+
+    // 圆：p1 为圆心，p2 为圆周上一点
+    const QPointF center = randomPos.p1;
+    const double centerPx = center.x() * frameW;
+    const double centerPy = center.y() * frameH;
+    const double edgePx = randomPos.p2.x() * frameW;
+    const double edgePy = randomPos.p2.y() * frameH;
+
+    const double radiusPx = std::sqrt((edgePx - centerPx) * (edgePx - centerPx) + (edgePy - centerPy) * (edgePy - centerPy));
+    if (radiusPx < 1.0) {
+        return center;
+    }
+
+    double px = centerPx;
+    double py = centerPy;
+
+    if (!useGauss) {
+        // 圆内均匀采样：r = R * sqrt(u)，保证面积均匀（而不是只在圆环上均匀）
+        const double u = rng->generateDouble();
+        const double v = rng->generateDouble();
+        const double r = radiusPx * std::sqrt(u);
+        const double theta = 2.0 * M_PI * v;
+        px = centerPx + r * std::cos(theta);
+        py = centerPy + r * std::sin(theta);
+    } else {
+        // 高斯：像素空间下各向同性，因此屏幕上仍是正圆而不是椭圆。
+        // 用拒绝采样裁到圆内，避免边缘堆积。
+        const double sigmaPx = qMax(radiusPx * randomPos.sigma, 1e-6);
