+        for (int i = 0; i < 24; ++i) {
+            const double dx = sigmaPx * nextGauss(rng);
+            const double dy = sigmaPx * nextGauss(rng);
+            if (dx * dx + dy * dy <= radiusPx * radiusPx) {
