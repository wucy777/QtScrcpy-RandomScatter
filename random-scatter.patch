+// 标准正态随机数（Box-Muller）。Qt 5.15 没有内置正态分布，只好自己来。
+static double nextGauss(QRandomGenerator *rng)
+{
+    double u1 = rng->generateDouble();
+    const double u2 = rng->generateDouble();
+    if (u1 < 1e-12) {
+        u1 = 1e-12;   // log(0) 保护
+    }
+    return std::sqrt(-2.0 * std::log(u1)) * std::cos(2.0 * M_PI * u2);
+}
