+                py = centerPy + dy;
+                accepted = true;
+                break;
+            }
+        }
+        if (!accepted) {
+            // 兜底：把最后一次采样径向夹回圆周上
+            double dx = px - centerPx;
+            double dy = py - centerPy;
+            double d = std::sqrt(dx * dx + dy * dy);
+            if (d < 1e-6) {
+                const double theta = 2.0 * M_PI * rng->generateDouble();
+                dx = std::cos(theta);
+                dy = std::sin(theta);
+                d = 1.0;
+            }
+            px = centerPx + dx / d * radiusPx;
+            py = centerPy + dy / d * radiusPx;
+        }
+    }
